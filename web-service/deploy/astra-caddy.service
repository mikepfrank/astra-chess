# HTTPS proxy; executable, configuration and TLS state remain under /home/astra.
[Unit]
Description=Astra Chess HTTPS proxy
After=network-online.target astra-chess.service
Wants=network-online.target

[Service]
Type=exec
User=astra
Group=astra
WorkingDirectory=/home/astra/.local/share/astra-caddy
Environment=HOME=/home/astra/.local/share/astra-caddy
Environment=XDG_DATA_HOME=/home/astra/.local/share/astra-caddy
Environment=XDG_CONFIG_HOME=/home/astra/.local/share/astra-caddy/config
ExecStart=/home/astra/.local/bin/caddy run --config /home/astra/.config/astra-chess/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/astra/.local/bin/caddy
BindReadOnlyPaths=/home/astra/.config/astra-chess/Caddyfile
BindPaths=/home/astra/.local/share/astra-caddy
ReadWritePaths=/home/astra/.local/share/astra-caddy
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
