# Copy to /home/astra/.config/astra-chess/service.env with mode 0600.
# Initial private deployment; change to the exact HTTPS origin with the proxy.
ASTRA_ORIGIN=http://127.0.0.1:8788
ASTRA_PLAYER=codex
ASTRA_MAX_WORKERS=1
ASTRA_MAX_DAILY_TURNS=500
ASTRA_MAX_TURN_TOKENS=3000000
ASTRA_MAX_DAILY_TOKENS=20000000
# Supply OPENAI_API_KEY through the service's protected environment mechanism.
# Optional recovery email:
# ASTRA_SMTP_HOST=smtp.example.com
# ASTRA_SMTP_PORT=587
# ASTRA_SMTP_FROM=Astra Chess <chess@example.com>
# ASTRA_SMTP_USER=
# ASTRA_SMTP_PASSWORD=
